# Application Config
APP_NAME=Gradify
APP_ENV=development
API_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + Asyncpg)
DB_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/gradify_db
DB_NAME=gradify_db

# Security & Authentication (JWT + Argon2)
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Backblaze B2 Object Storage (Documents, Assignments, Notes)
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_b2_bucket_name
B2_REGION_NAME=us-east-005

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER_EMAIL=your_email@gmail.com
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Gradify
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=30

# Celery & Redis (Optional / Async Outbox Dispatch)
REDIS_URL=redis://localhost:6379/0
CELERY_OUTBOX_POLL_SECONDS=5
CELERY_OUTBOX_BATCH_SIZE=100
